# Server
PORT=3001
HOST=0.0.0.0

# SQLite database path (set to :memory: for ephemeral storage)
DATABASE_PATH=./data/alert.db

# brapi.dev (required — API returns HTTP 401 without a token)
# Get a free token at https://brapi.dev/dashboard
BRAPI_TOKEN=

# Web Push (VAPID). Generate with: pnpm dlx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Allowed web origin (CORS)
WEB_ORIGIN=http://localhost:5173

# Scheduler
CHECK_INTERVAL_MS=900000
TZ=America/Sao_Paulo
